{
  "base": {
    "service": "payment",
    "replicas": 2,
    "servers": ["a", "b", "c", "d"],
    "limits": { "cpu": "500m", "mem": "256Mi" }
  },
  "patchA": [
    { "op": "remove", "path": "/servers/0" },
    { "op": "replace", "path": "/replicas", "value": 3 }
  ],
  "patchB": [
    { "op": "replace", "path": "/servers/2", "value": "C" },
    { "op": "add", "path": "/servers/1", "value": "b2" },
    { "op": "add", "path": "/limits/timeout", "value": "30s" }
  ]
}
